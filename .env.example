# ============================================================
# Environment Variables Template
# Copy to .env and fill in your credentials
# NEVER commit .env to version control
# ============================================================

# --- SharePoint Configuration (Primary Data Source) ---
# Azure AD Authentication (Recommended for Production)
SHAREPOINT_TENANT_ID=your-tenant-id-here
SHAREPOINT_CLIENT_ID=your-client-id-here
SHAREPOINT_CLIENT_SECRET=your-client-secret-here

# SharePoint Site Configuration
SHAREPOINT_SITE_URL=https://moh.sharepoint.com/sites/DataDojo
SHAREPOINT_SITE_ID=moh.sharepoint.com,{site-guid},{web-guid}
SHAREPOINT_DRIVE_ID=your-drive-id-here

# Data Folders
SHAREPOINT_WORKFORCE_FOLDER=/sites/DataDojo/Shared Documents/Gen-e2/data-analysis/workforce

# User Credentials (Alternative - Development Only, NOT recommended for production)
SHAREPOINT_USERNAME=your_email@moh.gov.sg
SHAREPOINT_PASSWORD=your_password

# --- Project Settings ---
PROJECT_NAME=gen-e2-workforce-analysis
LOG_LEVEL=INFO
DATA_RAW_PATH=shared/data/1_raw
DATA_EXTERNAL_PATH=shared/data/2_external
PROBLEM_PACKAGE=artifacts/ps-001-workforce-trends-forecasting
