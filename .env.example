# Environment Variables Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# ============================================================================
# Database Credentials
# ============================================================================
DB_HOST=your_database_host
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# ============================================================================
# Databricks Configuration
# ============================================================================
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=your_databricks_token
DATABRICKS_CLUSTER_ID=your_cluster_id
DATABRICKS_WORKSPACE_PATH=/Workspace/Users/your-username/

# ============================================================================
# External Data Sources
# ============================================================================
# Kaggle API (if using Kaggle datasets)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# AWS S3 (if using AWS storage)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=ap-southeast-1
AWS_S3_BUCKET=your_s3_bucket_name

# Azure Blob Storage (if using Azure)
AZURE_STORAGE_ACCOUNT=your_storage_account
AZURE_STORAGE_KEY=your_storage_key
AZURE_CONTAINER_NAME=your_container_name

# ============================================================================
# API Keys
# ============================================================================
# Add any API keys for external services here
API_KEY_SERVICE_1=your_api_key
API_KEY_SERVICE_2=your_api_key

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/app.log

# ============================================================================
# Project Settings
# ============================================================================
ENVIRONMENT=development  # development, staging, production
PROJECT_NAME=gen-e2-health-analysis
