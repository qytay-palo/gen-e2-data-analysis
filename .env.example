# ============================================================
# Environment Variables Template
# Copy to .env and fill in your credentials
# NEVER commit .env to version control
# ============================================================

# --- Kaggle API ---
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# --- Databricks (HEALIX) ---
DATABRICKS_HOST=https://adb-<workspace-id>.azuredatabricks.net
DATABRICKS_TOKEN=your_databricks_token
DATABRICKS_CLUSTER_ID=your_cluster_id

# --- Project Settings ---
PROJECT_NAME=sg-infectious-disease-analysis
LOG_LEVEL=INFO
DATA_RAW_PATH=shared/data/1_raw
DATA_EXTERNAL_PATH=shared/data/2_external
