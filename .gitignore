# ============================================================================
# Reports & Outputs (Keep templates, ignore generated)
# ============================================================================
# Generated reports
reports/**/*.pdf
reports/**/*.pptx
results/**/*.pdf
results/**/*.pptx
problem-statements/*/reports/**/*.pdf
problem-statements/*/reports/**/*.pptx

# Keep templates and examples
!reports/**/template*.pdf
!reports/**/example*.pptx

# Generated figures (can be regenerated)
reports/figures/**/*.png
reports/figures/**/*.jpg
reports/figures/**/*.svg
problem-statements/*/reports/figures/**/*.png
problem-statements/*/reports/figures/**/*.jpg

# Keep example figures
!reports/figures/example*.png
!reports/figures/template*.png

# ============================================================================
# Temporary Files
# ============================================================================
tmp/
temp/
*.tmp
*.temp
*.bak
*.backup

# ============================================================================
# Archive Files
# ============================================================================
*.zip
*.tar.gz
*.tar.bz2
*.rar
*.7z

# Keep documentation archives if any
!docs/**/*.zip

# ============================================================================
# Agent Handoffs (Keep structure, ignore runtime data)
# ============================================================================
data/3_interim/agent_handoffs/**/*.json
!data/3_interim/agent_handoffs/README.md
!data/3_interim/agent_handoffs/**/*example*.json

# ============================================================================
# SQL Dumps & Database Files
# ============================================================================
*.sql
*.db
*.sqlite
*.sqlite3

# Keep schema definitions and migration files
!sql/**/*.sql
!shared/sql/**/*.sql

# ============================================================================
# GitHub Specific (if using GitHub Actions)
# ============================================================================
# Workflow logs
.github/workflows/*.log

# ============================================================================
# Custom Project Specific
# ============================================================================
# Add any project-specific ignores below

# Kaggle downloaded datasets (except documented ones)
shared/data/1_raw/**/*
!shared/data/1_raw/README.md
!shared/data/1_raw/**/*_documentation*.md

# Keep small sample/test data
!shared/data/1_raw/samples/**/*
!shared/data/1_raw/test/**/*

# ============================================================================
# Notes
# ============================================================================
# 1. Raw data in shared/data/1_raw/ is ignored by default (too large for git)
# 2. Document data sources in docs/data_dictionary/
# 3. Use Git LFS for large files that must be tracked
# 4. Keep .env.example to show required environment variables
# 5. Never commit credentials or API keys
