# ============================================================================
# Data Files (Keep raw data, ignore processed/interim unless specified)
# ============================================================================
# Large data files
*.csv
*.tsv
*.xlsx
*.xls
*.parquet
*.feather
*.h5
*.hdf5
*.pkl
*.pickle

# EXCEPTION: Keep small reference/config data files
!config/**/*.csv
!config/**/*.xlsx
!shared/data/schemas/**/*.csv

# EXCEPTION: Keep data dictionaries and documentation
!docs/**/*.csv
!docs/**/*.xlsx

# Processed and interim data (regenerate from raw)
data/3_interim/**/*
data/4_processed/**/*
shared/data/3_interim/**/*
shared/data/4_processed/**/*
problem-statements/*/data/3_interim/**/*
problem-statements/*/data/4_processed/**/*

# Keep README files in data directories
!data/**/*README*.md
!shared/data/**/*README*.md
!problem-statements/*/data/**/*README*.md

# ============================================================================
# Machine Learning Models
# ============================================================================
# Trained models
*.model
*.h5
*.keras
*.pt
*.pth
*.ckpt
*.joblib
models/**/*.pkl
problem-statements/*/models/**/*

# Keep model configuration files
!models/**/*.json
!models/**/*.yaml
!models/**/*.yml
!problem-statements/*/models/**/*.json
!problem-statements/*/models/**/*.yaml

# ============================================================================
# Logs
# ============================================================================
logs/
*.log
*.out
*.err

# Keep empty log directories with README
!logs/README.md
!logs/**/README.md

